meta {
  name: create trade
  type: graphql
  seq: 5
}

post {
  url: http://127.0.0.1:8080/graphql
  body: graphql
  auth: inherit
}

headers {
  Authorization: eyJ0eXAiOiJKV1QiLCJhbGciOiJFZERTQSJ9.eyJleHAiOjE3NTc4NDczMDksInN1YiI6IjM3In0.Sb5E5qYYw5mhZvjpY8F9zHEtmkR8snrJN70XTp-DgxD-NLyAGc6Kmx3SdX8Y-VZPadFFqQTndfUn6F2TIeLHDA
}

body:graphql {
  mutation CreateTrade($input: CreateTradeInput!) {
    createTrade(input: $input) {
      id
      amount
      createdAt
      tradableItem {
        __typename
        id
        description
        hiddenUntil
        ... on TaskObject {
          dueBy
        }
      }
    }
  }
  
}

body:graphql:vars {
  {
    "input": {
      "taskId": 20
    }
  }
}

settings {
  encodeUrl: true
}
